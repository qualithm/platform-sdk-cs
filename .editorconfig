# Synced from dx by `dx baseline sync`; edits above the dx:repo-begin marker are overwritten.
# Repo-only rules go between `# dx:repo-begin` and `# dx:repo-end` at the end of the file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,go.sum,Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.{py,pyi,kt,kts,cs,c}]
indent_size = 4

# dx:repo-begin
[*.{csproj,props,targets,slnx,xml,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

[src/Qualithm.Platform/Generated/**.cs]
generated_code = true
dotnet_diagnostic.CS8073.severity = none
# dx:repo-end

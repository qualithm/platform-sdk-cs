root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = space
indent_size = 4
# File-scoped namespaces and `var` where the type is apparent.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
# Private fields are _camelCase.
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# The generated client (scripts/generate). Its files start with
# `// <auto-generated/>`, so dotnet format and the analyzers skip them; this
# silences the one compiler warning the generator trips: it null-checks
# non-nullable Guids.
[src/Qualithm.Platform/Generated/**.cs]
generated_code = true
dotnet_diagnostic.CS8073.severity = none

#!/bin/sh
# Regenerate the client from openapi.json with the pinned generator
# (Decision qualithm/pm#2394). Never edit src/Qualithm.Platform/Generated/ by
# hand: CI's Generated Drift job reruns this and fails on any difference.
set -eu

IMAGE="openapitools/openapi-generator-cli:v7.26.0@sha256:a304ddf1e2e5f24f68fa3153568d6174cea4959d09aa8e3db6d526fd0782326d"
OUT=src/Qualithm.Platform/Generated

cd "$(dirname "$0")/.."
rm -rf .generated "$OUT"
docker run --rm --user "$(id -u):$(id -g)" -v "$PWD:/local" "$IMAGE" \
  generate --config /local/openapi-generator.yaml --skip-validate-spec >/dev/null
# Only the sources ship; the generator's project, tests, docs and solution stay out.
mkdir -p "$OUT"
for dir in Api Client Model; do
  mv ".generated/src/Qualithm.Platform/$dir" "$OUT/$dir"
done
rm -rf .generated
# Mark every file generated, so dotnet format and the analyzers skip it, and
# keep the generator's own nullable setting (annotations only).
find "$OUT" -name '*.cs' | sort | while read -r f; do
  { printf '// <auto-generated/>\n#nullable enable annotations\n'; cat "$f"; } > "$f.tmp" && mv "$f.tmp" "$f"
done
